{
  "name": "money-movement-platform",
  "version": "1.0.0",
  "description": "Money movement platform: idempotent, concurrency-safe transfers on an immutable double-entry ledger, Stripe test deposits, mock-bank payouts, and reconciliation against provider records",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/outbox/run.ts",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard && tsc --noEmit -p wallet",
    "test": "vitest run",
    "mock-bank": "tsx src/bank/run.ts",
    "dashboard": "vite --config dashboard/vite.config.ts",
    "dashboard:build": "vite build --config dashboard/vite.config.ts",
    "wallet": "vite --config wallet/vite.config.ts",
    "wallet:build": "vite build --config wallet/vite.config.ts",
    "demo": "docker compose up --build",
    "demo:seed": "tsx scripts/demo-seed.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "stripe": "23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
