{
  "name": "money-movement-platform",
  "version": "1.0.0",
  "description": "Money movement platform: idempotent, concurrency-safe transfers on an immutable double-entry ledger, Stripe test deposits and mock-bank payouts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/outbox/run.ts",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock-bank": "tsx src/bank/run.ts"
  },
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "stripe": "23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
