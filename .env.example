DATABASE_URL=postgres://postgres:postgres@localhost:5432/money_dev
PORT=3000

# Outbox worker (`npm run worker`). Where to POST events; unset logs them to stdout.
OUTBOX_WEBHOOK_URL=
# Publish attempts per event before it is marked dead.
OUTBOX_MAX_ATTEMPTS=10

# --- Stripe (TEST MODE ONLY) ---------------------------------------------
# Never commit real values. Copy this file to .env (which is gitignored).
# Secret key from https://dashboard.stripe.com/test/apikeys. Must start with
# sk_test_ or rk_test_; the server refuses to start with a live key.
STRIPE_SECRET_KEY=
# Signing secret printed by `stripe listen --forward-to localhost:3000/webhooks/stripe`
# (or from a test-mode webhook endpoint in the dashboard). Starts with whsec_.
STRIPE_WEBHOOK_SECRET=
# Where Checkout sends the browser back to after paying or cancelling.
APP_BASE_URL=http://localhost:3000

# --- Mock bank (payouts) ---------------------------------------------------
# Shared secret the mock bank signs webhooks with and the API verifies.
BANK_WEBHOOK_SECRET=local_mock_bank_secret
# Where the worker sends payouts (`npm run mock-bank` listens on 4000). Unset: payouts stay pending.
BANK_API_URL=http://localhost:4000
# Where the mock bank sends its webhooks, and how long it takes to settle a payout.
BANK_WEBHOOK_URL=http://localhost:3000/webhooks/bank
BANK_SETTLE_AFTER_MS=5000
# How often the worker asks the bank about payouts that have been quiet for PAYOUT_RECONCILE_QUIET_MS.
PAYOUT_RECONCILE_EVERY_MS=30000
PAYOUT_RECONCILE_QUIET_MS=60000

# --- Reconciliation and the admin dashboard -------------------------------
# Bearer token for /admin and the dashboard at /dashboard/. Unset: both are disabled.
ADMIN_TOKEN=local-admin-token
# How often the worker runs a full reconciliation against each configured provider (0 = never).
RECONCILE_EVERY_MS=300000

# --- User wallet (/wallet/) ------------------------------------------------
# Signs the wallet's demo sign-in tokens. Unset: the wallet and /me are disabled.
WALLET_SESSION_SECRET=local-wallet-secret
# Local demos only. With no STRIPE_SECRET_KEY, deposits use the demo checkout
# page (signed events through the real webhook), and the wallet shows the mock
# bank's failure switches. Lets any signed-in user mint fictional money.
DEMO_MODE=true
